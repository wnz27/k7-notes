/* utils */
white(a)
  rgba(255, 255, 255, a)

black(a)
  rgba(0, 0, 0, a)

rainbow-light = linear-gradient(to right, oklch(0.80 0.10 0), oklch(0.80 0.10 30), oklch(0.80 0.10 60), oklch(0.80 0.10 90), oklch(0.80 0.10 120), oklch(0.80 0.10 150), oklch(0.80 0.10 180), oklch(0.80 0.10 210), oklch(0.80 0.10 240), oklch(0.80 0.10 270), oklch(0.80 0.10 300), oklch(0.80 0.10 330), oklch(0.80 0.10 360))
rainbow-dark = linear-gradient(to right, oklch(0.70 0.10 0), oklch(0.70 0.10 30), oklch(0.70 0.10 60), oklch(0.70 0.10 90), oklch(0.70 0.10 120), oklch(0.70 0.10 150), oklch(0.70 0.10 180), oklch(0.70 0.10 210), oklch(0.70 0.10 240), oklch(0.70 0.10 270), oklch(0.70 0.10 300), oklch(0.70 0.10 330), oklch(0.70 0.10 360))

:root
  --radius-large 1rem
  --content-delay 150ms

/* An util to define variables that vary with light and dark mode */
define(vars)
  :root
    for key, value in vars
      {key}: value[0]
  :root.dark
    for key, value in vars
      if length(value) > 1
        {key}: value[1]

define({
  --primary: #376657 #a3c6ac
  --page-bg: #f2f0e8 #191e1b
  --card-bg: #fbfaf5 #232a25
  --text-strong: #292d26 #e7e9dc
  --text-body: #454b41 #d0d6c9
  --text-muted: #686f63 #abb4a7

  --btn-content: #376657 #b5d0b9

  --btn-regular-bg: #e7ecdf #303e32
  --btn-regular-bg-hover: #dce5d5 #3a4b3d
  --btn-regular-bg-active: #d1ddc8 #435747

  --btn-plain-bg-hover: #e8ecdf #303e32
  --btn-plain-bg-active: #dce4d5 #3a4b3d

  --btn-card-bg-hover: #eeeee3 #2d3930
  --btn-card-bg-active: #e3e8d9 #364638
  --btn-dark-bg: #435748 #344738
  --btn-dark-bg-hover: #526a57 #415a46
  --btn-dark-bg-active: #607c66 #4e6b54

  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)

  --deep-text: var(--text-strong)

  --title-active: #294f43 #c1d6ba

  --line-divider: #dedfd2 #39453b

  --line-color: #d2d6c7 #465447
  --meta-divider: #a0a695 #6f7c6c

  --inline-code-bg: var(--btn-regular-bg)
  --inline-code-color: var(--btn-content)
  --selection-bg: #d5dfc5 #435a43
  --codeblock-selection: #435a43
  --codeblock-bg: #202820 #161d18
  --codeblock-topbar-bg: #2c382e #111713

  --license-block-bg: #eceee1 var(--codeblock-bg)

  --link-underline: #b7c6ae #58795b
  --link-hover: #88a48b #8eaf8d
  --link-active: #376657 #a3c6ac

  --float-panel-bg: #fbfaf5 #28322a

  --scrollbar-bg-light: #a5af9c
  --scrollbar-bg-hover-light: #7d8d78
  --scrollbar-bg-active-light: #526f57

  --scrollbar-bg-dark: #5b6b58
  --scrollbar-bg-hover-dark: #7e9276
  --scrollbar-bg-active-dark: #a3b99a

  --scrollbar-bg: var(--scrollbar-bg-light) var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light) var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light) var(--scrollbar-bg-active-dark)

  --color-selection-bar: rainbow-light rainbow-dark

  --display-light-icon: 1 0
  --display-dark-icon: 0 1

  --admonitions-color-tip: #376657 #a3c6ac
  --admonitions-color-note: #506e87 #a8bfd0
  --admonitions-color-important: #79658e #bfb0d3
  --admonitions-color-warning: #826726 #d2b773
  --admonitions-color-caution: #a05237 #dda58b

  --toc-badge-bg: #e0e7d3 var(--btn-regular-bg)
  --toc-btn-hover: #e8ecdf #2d3930
  --toc-btn-active: #dce5d5 #364638
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: #dce7d3 #344b39
})
